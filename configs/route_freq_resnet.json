{
  "route": "freq_resnet",
  "seed": 2026,
  "data": {
    "train": {"start": 0, "stop": 8000},
    "validation": {"start": 20000, "stop": 21000},
    "internal_test": {"start": 30000, "stop": 31000},
    "dataset_dir": "cache/dataset",
    "batch_size": 32
  },
  "representation": {"type": "frequency"},
  "normalization": {
    "type": "per_channel_position",
    "stats_file": "artifacts/common/norm_stats.npz",
    "stats_key": "freq",
    "eps": 1e-06
  },
  "encoder": {
    "type": "resnet",
    "in_channels": 4,
    "channels": [64, 96, 128],
    "blocks_per_stage": 2,
    "kernel_size": 9,
    "dilation_cycle": [1, 2, 4],
    "norm": "group",
    "groups": 8,
    "dropout": 0.0,
    "use_pooling": true,
    "multiscale": true,
    "pool_kernel": 4,
    "pool_stride": 2
  },
  "pooling": {
    "type": "info_preserving",
    "kernel_size": 4,
    "stride": 2,
    "tau": 1.0,
    "learnable_tau": true,
    "tau_min": 0.05
  },
  "aggregate": {"type": "multiscale", "length": 8},
  "head": {"type": "res_mlp", "hidden": 256, "blocks": 2, "dropout": 0.0, "output_dim": 41},
  "anchor_file": "artifacts/common/anchor.npz",
  "output_clamp": false,
  "train": {
    "seed": 2026,
    "epochs": 1,
    "batch_size": 32,
    "learning_rate": 0.0003,
    "weight_decay": 0.0001,
    "optimizer": "adamw",
    "grad_clip": 1.0,
    "amp": true,
    "device": "auto",
    "scheduler": "cosine",
    "loss": "huber",
    "huber_delta": 1.0
  }
}
